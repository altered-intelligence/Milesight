# Copy to .env. Every variable is optional for local development: with nothing
# set, the server runs the vehicle simulator on an in-memory store.

# --- server
MILESIGHT_ADDR=:8080
MILESIGHT_PUBLIC_URL=http://localhost:8080        # used to build the Tesla OAuth redirect URI
LOG_LEVEL=info                                    # debug | info | warn | error
MILESIGHT_CORS_ORIGINS=                           # comma-separated web origins (native apps need none)

# --- storage: memory (default without DATABASE_URL) or postgres
# DATABASE_URL=postgres://milesight:milesight@localhost:5432/milesight?sslmode=disable
# MILESIGHT_STORE=postgres

# --- secrets (REQUIRED in production; the defaults are development-only)
JWT_SECRET=dev-secret-change-me
# MILESIGHT_ENCRYPTION_KEY=                       # openssl rand -base64 32
# MILESIGHT_ACCESS_TTL=15m
# MILESIGHT_REFRESH_TTL=1440h

# --- Tesla transport: sim (default) | owner (dev only) | fleet (production)
MILESIGHT_TRANSPORT=sim
# MILESIGHT_DEV_LOGIN=true                        # simulator accounts (default on for sim)
# MILESIGHT_OWNER_LOGIN=false                     # sign in with an Owner API refresh token
MILESIGHT_APP_REDIRECT=milesight://auth/callback  # where the OAuth redirect bounces to the app

# Fleet API (developer.tesla.com). Scopes may be comma- or space-separated.
# TESLA_CLIENT_ID=
# TESLA_CLIENT_SECRET=
# TESLA_REDIRECT_URI=                             # default: $MILESIGHT_PUBLIC_URL/v1/auth/tesla/redirect
# TESLA_REGION=na                                 # na | eu | cn
TESLA_SCOPES=openid offline_access user_data vehicle_device_data vehicle_location vehicle_cmds vehicle_charging_cmds
# Signed commands (2021+ vehicles) go through Tesla's vehicle-command HTTP proxy:
# TESLA_COMMAND_PROXY_URL=https://localhost:4443
# TESLA_COMMAND_PROXY_CA_FILE=/path/to/proxy-cert.pem

# --- push notifications (APNs token auth). Without these, pushes are logged.
# APNS_KEY_FILE=/secrets/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
APNS_TOPIC=com.milesight.ios
APNS_ENVIRONMENT=sandbox

# --- simulator
MILESIGHT_SIM_HOME_LAT=37.3947
MILESIGHT_SIM_HOME_LON=-122.1503
MILESIGHT_SIM_VEHICLES=2
MILESIGHT_SIM_HISTORY_DAYS=30
